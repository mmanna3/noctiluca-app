{
  "expo": {
    "name": "Noctiluca",
    "slug": "noctiluca",
    "scheme": "noctiluca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "platforms": [
      "ios",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.mmanna3.noctiluca",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Noctiluca usa Face ID para desbloquear el acceso a la app y a las carpetas privadas.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://trusting-burnell.192-64-87-146.plesk.page",
      "eas": {
        "projectId": "1b420a94-3b41-4685-8e13-74fe33fa8eb1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1b420a94-3b41-4685-8e13-74fe33fa8eb1"
    },
    "android": {
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    }
  }
}
